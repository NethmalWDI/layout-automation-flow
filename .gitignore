.venv/
__pycache__/
*.pyc
*.raw
external/
runs/tmp/
node_modules/
.incoming/
*.ext
runs/align/*/LOG/
outputs/S0/*/tb/rawspice.raw
runs/S0_negctl/
# the previous run's S2 / S3 files, kept locally when a new run starts from a clean folder (src/common/hygiene.py)
outputs/S2/*.prev/
outputs/S3/*.prev/
outputs/S4/*.prev/
outputs/S5/*.prev/
outputs/S6/*.prev/
outputs/S7/*.prev/
# S7 benches with the R+C netlist pasted in: 3 MB each, copies of outputs/S6/<d>/<layout>/*_pexrc.spice, regenerated by S7
outputs/S7/*/sim/*/pex_rc/*/*.spice
# post-hoc S3 variants: the simulation folders (about 120 MB per design), regenerated by scripts/plan_v2_after_queue.sh
outputs/posthoc/*/*/sim/
outputs/posthoc/*/*/S2/work/
# R+C extraction of the hand layouts: 20 MB netlists and Magic work files, regenerated by scripts/reference_*.sh
outputs/reference_layout/*/*_pexrc.spice
outputs/reference_layout/*/rc_run/
