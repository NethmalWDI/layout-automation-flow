let s1_xm9_csg = @m.x1.xdut.xm9.msky130_fd_pr__nfet_01v8[csg]
echo OPV XM9 csg $&s1_xm9_csg
let s1_xm9_csd = @m.x1.xdut.xm9.msky130_fd_pr__nfet_01v8[csd]
echo OPV XM9 csd $&s1_xm9_csd
let s1_xm9_css = @m.x1.xdut.xm9.msky130_fd_pr__nfet_01v8[css]
echo OPV XM9 css $&s1_xm9_css
let s1_xm9_csb = @m.x1.xdut.xm9.msky130_fd_pr__nfet_01v8[csb]
echo OPV XM9 csb $&s1_xm9_csb
let s1_xm9_cbg = @m.x1.xdut.xm9.msky130_fd_pr__nfet_01v8[cbg]
echo OPV XM9 cbg $&s1_xm9_cbg
let s1_xm9_cbd = @m.x1.xdut.xm9.msky130_fd_pr__nfet_01v8[cbd]
echo OPV XM9 cbd $&s1_xm9_cbd
let s1_xm9_cbs = @m.x1.xdut.xm9.msky130_fd_pr__nfet_01v8[cbs]
echo OPV XM9 cbs $&s1_xm9_cbs
let s1_xm9_cbb = @m.x1.xdut.xm9.msky130_fd_pr__nfet_01v8[cbb]
echo OPV XM9 cbb $&s1_xm9_cbb
let s1_xm9_capbd = @m.x1.xdut.xm9.msky130_fd_pr__nfet_01v8[capbd]
echo OPV XM9 capbd $&s1_xm9_capbd
let s1_xm9_capbs = @m.x1.xdut.xm9.msky130_fd_pr__nfet_01v8[capbs]
echo OPV XM9 capbs $&s1_xm9_capbs
let s1_xm9_cgso = @m.x1.xdut.xm9.msky130_fd_pr__nfet_01v8[cgso]
echo OPV XM9 cgso $&s1_xm9_cgso
let s1_xm9_cgdo = @m.x1.xdut.xm9.msky130_fd_pr__nfet_01v8[cgdo]
echo OPV XM9 cgdo $&s1_xm9_cgdo
let s1_xm9_cgbo = @m.x1.xdut.xm9.msky130_fd_pr__nfet_01v8[cgbo]
echo OPV XM9 cgbo $&s1_xm9_cgbo
let s1_xm9_weff = @m.x1.xdut.xm9.msky130_fd_pr__nfet_01v8[weff]
echo OPV XM9 weff $&s1_xm9_weff
let s1_xm9_leff = @m.x1.xdut.xm9.msky130_fd_pr__nfet_01v8[leff]
echo OPV XM9 leff $&s1_xm9_leff
let s1i = i(vsup)
echo OPI isup $&s1i
let s1o = v(OUTP) - v(OUTN)
let s1cm = (v(OUTP) + v(OUTN)) / 2
echo OPI voutcm $&s1cm
echo OPI vout $&s1o
quit 0
.endc
**.ends

.subckt dut_amp INP INN OUTN VDD VSS OUTP
XDUT INP INN OUTP OUTN VDD VSS cmc_w cm_w bias_a_w iadc_ota
* ideal CMFB: the steady-state law of the upstream switched-capacitor CMFB (ASSUMPTION)
Bcmfb cmc_w VSS V = v(bias_a_w) + (v(OUTP) + v(OUTN))/2 - v(cm_w)
.ends

