* ttsky25a_fd on dido_amp_AC
.lib $PDK_ROOT/sky130A/libs.tech/combined/sky130.lib.spice tt
.option rshunt=1e12
.param VDD_V=1.8 VCM_V=0.9 CL_F=529f
.temp 27

**.subckt dido_amp_AC
x1 INP INN OUTN VDD 0 OUTP dut_amp
Vsup VDD 0 'VDD_V'
* AC drive through 1 F couplers; DC set by unity feedback through 1 GH chokes (OUTP->INN, OUTN->INP)
Vacp ACP 0 dc 0 ac 0.5
Vacn ACN 0 dc 0 ac -0.5
Cinp ACP INP 1
Cinn ACN INN 1
Lfbp OUTP INN 1G
Lfbn OUTN INP 1G
XCloadp OUTP 0 sky130_fd_pr__cap_mim_m3_1 W=1 L=1 MF=100 M=100
XCloadn OUTN 0 sky130_fd_pr__cap_mim_m3_1 W=1 L=1 MF=100 M=100
.control
  save all
  ac dec 40 1 1G
  let hsig = v(OUTP) - v(OUTN)
  let hdb = db(hsig)
  let gph_deg = 180/pi * cph(hsig)
  meas ac gain_db find hdb at=1
  meas ac gbw_hz  when hdb=0
  meas ac ph_dc   find gph_deg at=1
  meas ac ph_ugb  find gph_deg when hdb=0
  let gbw_mhz = gbw_hz / 1e6
  let pm_deg  = 180 + (ph_ugb - ph_dc)
  echo MEAS gain_db $&gain_db
  echo MEAS gbw_mhz $&gbw_mhz
  echo MEAS pm_deg $&pm_deg
  write
  quit 0
.endc
**.ends

.subckt dut_amp INP INN OUTN VDD VSS OUTP
XDUT VSS VREF INP INN RGM OUTP OUTN NC_ua_6_ NC_ua_7_ EN1 EN2 VDD NC_tt_um_Fully_Diff_Opamp_0_Diff_Opamp_0_2stage_op_amp_1_Diff_opamp_ly_0_Vbias3 NC_tt_um_Fully_Diff_Opamp_0_Diff_Opamp_0_2stage_op_amp_1_Diff_opamp_ly_0_Vbias2 NC_tt_um_Fully_Diff_Opamp_0_Diff_Opamp_0_2stage_op_amp_1_Diff_opamp_ly_0_nmos_cload_01_1_Vbias1 NC_tt_um_Fully_Diff_Opamp_0_Diff_Opamp_0_2stage_op_amp_1_switchblock_1_beta NC_tt_um_Fully_Diff_Opamp_0_Diff_Opamp_0_2stage_op_amp_1_bias_dummy_0_PBias NC_tt_um_Fully_Diff_Opamp_0_Diff_Opamp_0_2stage_op_amp_1_bias_dummy_0_Vbias1 NC_tt_um_Fully_Diff_Opamp_0_Diff_Opamp_0_2stage_op_amp_1_bias_dummy_0_Vbias2 NC_tt_um_Fully_Diff_Opamp_0_Diff_Opamp_0_2stage_op_amp_1_bias_dummy_0_Vbias3 NC_tt_um_Fully_Diff_Opamp_0_Diff_Opamp_0_2stage_op_amp_1_bias_dummy_0_Vbias4 tt_um_diff_flat
Rgm_ext RGM VSS 12k
Vref_ext VREF VSS 0.9
Ven1 EN1 VSS 1.8
Ven2 EN2 VSS 0
.ends
