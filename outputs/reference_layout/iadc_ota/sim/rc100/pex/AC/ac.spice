* iadc_ota on dido_amp_AC
.lib $PDK_ROOT/sky130A/libs.tech/combined/sky130.lib.spice tt
.option rshunt=1e12
.param VDD_V=1.8 VCM_V=0.9 CL_F=0.3p
.temp 27

**.subckt dido_amp_AC
x1 INP INN OUTN VDD 0 OUTP dut_amp
Vsup VDD 0 'VDD_V'
* AC drive through 1 F couplers; DC set by unity feedback through 1 GH chokes (OUTP->INN, OUTN->INP)
Vacp ACP 0 dc 0 ac 0.5
Vacn ACN 0 dc 0 ac -0.5
Cinp ACP INP 1
Cinn ACN INN 1
Lfbp OUTP INN 1G
Lfbn OUTN INP 1G
Cloadp OUTP 0 'CL_F'
Cloadn OUTN 0 'CL_F'
.control
  save all
  ac dec 40 1 1G
  let hsig = v(OUTP) - v(OUTN)
  let hdb = db(hsig)
  let gph_deg = 180/pi * cph(hsig)
  meas ac gain_db find hdb at=1
  meas ac gbw_hz  when hdb=0
  meas ac ph_dc   find gph_deg at=1
  meas ac ph_ugb  find gph_deg when hdb=0
  let gbw_mhz = gbw_hz / 1e6
  let pm_deg  = 180 + (ph_ugb - ph_dc)
  echo MEAS gain_db $&gain_db
  echo MEAS gbw_mhz $&gbw_mhz
  echo MEAS pm_deg $&pm_deg
  write
  quit 0
.endc
**.ends

.subckt dut_amp INP INN OUTN VDD VSS OUTP
XDUT INP INN p1_w p1b_w p2_w p2b_w OUTP OUTN ib_w cm_w VDD VSS cmc_w bias_a_w NC_bias_d NC_bias_c NC_bias_b NC_sc_cmfb_0_transmission_gate_9_in NC_sc_cmfb_0_transmission_gate_7_in NC_sc_cmfb_0_transmission_gate_5_in NC_sc_cmfb_0_transmission_gate_3_in NC_sc_cmfb_0_transmission_gate_2_out NC_sc_cmfb_0_transmission_gate_1_in p1_w p1b_w p2_w p2b_w VDD VDD VDD VDD VDD VDD VDD VDD VDD VDD VDD VDD ota_flat
Bcmfb cmc_w VSS V = v(bias_a_w) + (v(OUTP) + v(OUTN))/2 - v(cm_w)
Ibias_ext VDD ib_w 30u
Vp1 p1_w VSS 1.8
Vp1b p1b_w VSS 0
Vp2 p2_w VSS 0
Vp2b p2b_w VSS 1.8
.ends
.subckt iadc_ota ip in op on VDD VSS cmc cm bias_a
