* iadc_ota on dido_amp_OP
.lib $PDK_ROOT/sky130A/libs.tech/combined/sky130.lib.spice tt
.options klu
.option rshunt=1e12
.param VDD_V=1.8 VCM_V=0.9 CL_F=0.3p
.temp 27

**.subckt dido_amp_OP
x1 INP INN OUTN VDD 0 OUTP dut_amp
Vsup VDD 0 'VDD_V'
* AC drive through 1 F couplers; DC set by unity feedback through 1 GH chokes (OUTP->INN, OUTN->INP)
Vacp ACP 0 dc 0 ac 0
Vacn ACN 0 dc 0 ac 0
Cinp ACP INP 1
Cinn ACN INN 1
Lfbp OUTP INN 1G
Lfbn OUTN INP 1G
Cloadp OUTP 0 'CL_F'
Cloadn OUTN 0 'CL_F'
.control
  save all
  op
  let isup    = abs(i(vsup))
  let isup_ua = isup * 1e6
  let power_uw = isup * v(VDD) * 1e6
  let vout_v  = v(OUTP) - v(OUTN)
  echo MEAS isup_ua $&isup_ua
  echo MEAS power_uw $&power_uw
  echo MEAS vout_v $&vout_v
  let voutcm_v = (v(OUTP) + v(OUTN)) / 2
  echo MEAS voutcm_v $&voutcm_v
  write
  quit 0
.endc
**.ends

.subckt dut_amp INP INN OUTN VDD VSS OUTP
XDUT INP INN p1_w p1b_w p2_w p2b_w OUTP OUTN ib_w cm_w VDD VSS cmc_w bias_a_w NC_bias_d NC_bias_c NC_bias_b p2b_w p2_w p1b_w p1_w OUTP OUTN cmc_w cm_w bias_a_w VDD VSS p1b_w NC_sc_cmfb_0_transmission_gate_11_in p1_w OUTP VDD VSS p1b_w bias_a_w p1_w NC_sc_cmfb_0_transmission_gate_10_out VDD VSS p1b_w NC_sc_cmfb_0_transmission_gate_9_in p1_w OUTN VDD VSS p1b_w cm_w p1_w NC_sc_cmfb_0_transmission_gate_8_out VDD VSS p1b_w NC_sc_cmfb_0_transmission_gate_7_in p1_w cmc_w VDD VSS p1b_w cm_w p1_w NC_sc_cmfb_0_transmission_gate_6_out VDD VSS p2b_w NC_sc_cmfb_0_transmission_gate_5_in p2_w cmc_w VDD VSS p2b_w cm_w p2_w NC_sc_cmfb_0_transmission_gate_4_out VDD VSS p2b_w NC_sc_cmfb_0_transmission_gate_3_in p2_w OUTN VDD VSS p2b_w cm_w p2_w NC_sc_cmfb_0_transmission_gate_2_out VDD VSS p2b_w NC_sc_cmfb_0_transmission_gate_1_in p2_w OUTP VDD VSS p2b_w bias_a_w p2_w NC_sc_cmfb_0_transmission_gate_0_out VDD VSS NC_sc_cmfb_0_p1_uq0 p1_w NC_sc_cmfb_0_p1_b_uq0 p1b_w NC_sc_cmfb_0_p2_uq0 p2_w NC_sc_cmfb_0_p2_b_uq0 p2b_w VSS VSS VSS VSS VSS VSS VSS VSS VSS VSS VSS VSS VSS VSS VSS VSS VSS VSS VSS VSS VSS VSS NC_sc_cmfb_0_VSS_uq0 NC_sc_cmfb_0_VSS_uq1 NC_sc_cmfb_0_VSS_uq2 NC_sc_cmfb_0_VSS_uq3 NC_sc_cmfb_0_VSS_uq4 NC_sc_cmfb_0_VSS_uq5 NC_sc_cmfb_0_VSS_uq6 NC_sc_cmfb_0_VSS_uq7 NC_sc_cmfb_0_VSS_uq8 NC_sc_cmfb_0_VSS_uq9 NC_sc_cmfb_0_VSS_uq10 NC_sc_cmfb_0_VDD_uq0 NC_sc_cmfb_0_VDD_uq1 NC_sc_cmfb_0_VDD_uq2 NC_sc_cmfb_0_VDD_uq3 NC_sc_cmfb_0_VDD_uq4 NC_sc_cmfb_0_VDD_uq5 NC_sc_cmfb_0_VDD_uq6 NC_sc_cmfb_0_VDD_uq7 NC_sc_cmfb_0_VDD_uq8 NC_sc_cmfb_0_VDD_uq9 NC_sc_cmfb_0_VDD_uq10 VDD VDD VDD VDD VDD VDD VDD VDD VDD VDD VDD VDD ota_flat
Bcmfb cmc_w VSS V = v(bias_a_w) + (v(OUTP) + v(OUTN))/2 - v(cm_w)
Ibias_ext VDD ib_w 30u
Vp1 p1_w VSS 1.8
Vp1b p1b_w VSS 0
Vp2 p2_w VSS 0
Vp2b p2b_w VSS 1.8
.ends
